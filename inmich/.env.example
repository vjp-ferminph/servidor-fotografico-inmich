
# ==========================================
# CONFIGURACION GENERAL DE IMMICH
# ==========================================

# Version de Immich
IMMICH_VERSION=v3

# Directorio de fotografias y videos
UPLOAD_LOCATION=./data

# Directorio de la base de datos
DB_DATA_LOCATION=./postgres

# ==========================================
# CONFIGURACION DE POSTGRESQL
# ==========================================

DB_DATABASE_NAME=immich
DB_USERNAME=postgres

# IMPORTANTE: establecer una contraseña propia
DB_PASSWORD=CAMBIAR_POR_UNA_PASSWORD_SEGURA

# ==========================================
# CONFIGURACION DEL SISTEMA
# ==========================================

TZ=Europe/Madrid
